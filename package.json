{
  "name": "cronometro-de-estudos",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Cronômetro de estudos local-first com matérias coloridas, histórico, comentários, estatísticas e metas.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
